# Copia este archivo como .env.local para desarrollo local.
# En Vercel, añade estas variables en Project Settings → Environment Variables.

# URL pública de la web (para SEO, Open Graph y sitemap). Ej: https://www.tudominio.es
# En Vercel, si no la defines, se usa automáticamente el dominio de producción del proyecto.
NEXT_PUBLIC_SITE_URL=

# (Opcional) Número de WhatsApp con prefijo internacional, sin "+" ni espacios. Ej: 34600111222
# Si no lo defines, se usa el número configurado en src/config/site.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Correo donde quieres recibir consultas (se muestra en la web y se usa como alternativa de envío).
NEXT_PUBLIC_CONTACT_EMAIL=

# (Opcional) URL a la que el servidor enviará cada solicitud del formulario en formato JSON.
# Compatible con servicios gratuitos como Formspree, Make, Zapier, n8n o webhooks de Slack/Discord.
# Es privada: nunca se expone en el navegador.
ORDER_WEBHOOK_URL=
